# vim: set ft=zsh:

[[ "$1" == "-h" || "$1" == "--help" ]] && { echo "Usage: tdl [<opencode|gemini|others>]"; return 1; }
[[ -z $TMUX ]] && { echo "You must start tmux to use tdl."; return 1; }
[[ $PWD == $HOME ]] && {echo "You're currently in the home directory, please go to a project directory first."; return 1; }

local current_dir="${PWD}"
local editor_pane ai_pane
local ai="$1"

# Use TMUX_PANE for the pane we're running in (stable even if active window changes)
editor_pane="$TMUX_PANE"

# Name the current session after the base directory name
tmux rename-session "$(basename "$current_dir")"
# Name the current window "editor"
tmux rename-window -t "$editor_pane" "editor"

# Split window vertically - top 85%, bottom 15% (target editor pane explicitly)
# tmux split-window -v -p 15 -t "$editor_pane" -c "$current_dir"

# If first ai provided, split editor pane horizontally - AI on right 25% (capture new pane ID directly)
if [[ -n $ai ]]; then
ai_pane=$(tmux split-window -h -p 25 -t "$editor_pane" -c "$current_dir" -P -F '#{pane_id}')
tmux send-keys -t "$ai_pane" "$ai" C-m
fi

# Run nvim in the left pane
tmux send-keys -t "$editor_pane" "$EDITOR ." C-m

# Create new window for terminal and split in two
tmux new-window -n "terminal" -c "$current_dir"
tmux split-window -h -c "$current_dir"

# Select the editor window for focus
tmux select-window -t "editor"

# Select the nvim pane for focus
tmux select-pane -t "$editor_pane"

